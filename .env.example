# ------------------------------------------------------------------
# ToyoToyo — Environment Variables
# Vercel-এ Deploy করার সময় এই ২টা মান "Environment Variables" অংশে দিন।
# ------------------------------------------------------------------

# আপনার PostgreSQL database এর connection string
# (Neon.tech / Supabase থেকে copy করে এখানে বসান)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# লগইন session সুরক্ষিত রাখার জন্য যেকোনো লম্বা random লেখা
AUTH_SECRET="toyotoyo-secret-2026-change-this-to-something-random-987654"
